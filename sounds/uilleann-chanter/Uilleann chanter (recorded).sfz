// Uilleann chanter (practice set in D), recorded by Fancy Butler. CC0.
// Built by Noodle from one recording of the scale: looped, levelled, overall +34 cents removed so low D sits at A440 pitch; each note keeps its own tuning.
<control> default_path=samples/
<global> loop_mode=loop_continuous ampeg_attack=0.006 ampeg_release=0.06
<region> sample=062.wav lokey=58 hikey=62 pitch_keycenter=62 tune=-34 loop_start=20648 loop_end=81632
<region> sample=063.wav lokey=63 hikey=63 pitch_keycenter=63 tune=-34 loop_start=18728 loop_end=74068
<region> sample=064.wav lokey=64 hikey=65 pitch_keycenter=64 tune=-34 loop_start=15248 loop_end=60534
<region> sample=066.wav lokey=66 hikey=66 pitch_keycenter=66 tune=-34 loop_start=17408 loop_end=68888
<region> sample=067.wav lokey=67 hikey=68 pitch_keycenter=67 tune=-34 loop_start=18248 loop_end=72599
<region> sample=069.wav lokey=69 hikey=70 pitch_keycenter=69 tune=-34 loop_start=17528 loop_end=69484
<region> sample=071.wav lokey=71 hikey=72 pitch_keycenter=71 tune=-34 loop_start=16808 loop_end=66875
<region> sample=073.wav lokey=73 hikey=73 pitch_keycenter=73 tune=-34 loop_start=15128 loop_end=60086
