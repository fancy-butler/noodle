// Uilleann drones (tenor D4, baritone D3, bass D2 together), recorded by Fancy Butler. CC0.
// Cut from a recording of the practice set's drones after tuning; looped with a baked crossfade.
// Measured: tenor 295.3 Hz (+10 cents), so tune=-10 puts it at A440 pitch; pitch_keycenter is the tenor.
<control> default_path=samples/
<region> sample=drones.wav lokey=0 hikey=127 pitch_keycenter=62 tune=-10 loop_mode=loop_continuous loop_start=30870 loop_end=208572 ampeg_attack=0.15 ampeg_release=0.4
